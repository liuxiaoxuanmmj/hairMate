# Documentation only. Commands never load .env automatically.
# Local disposable PostgreSQL from infra/compose.test.yaml (no real credential).
APP_ENV=development
AI_MODE=fake
STORAGE_MODE=local
DATABASE_URL=postgresql://hairmate_test@127.0.0.1:55432/hairmate_test
# Tests require this explicit isolated URL; never fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql://hairmate_test@127.0.0.1:55432/hairmate_test
API_HOST=127.0.0.1
API_PORT=3000
API_ALLOWED_ORIGIN=http://localhost:8081
WORKER_INTERVAL_MS=5000
# Public address only. On a device use a reachable development API address.
EXPO_PUBLIC_API_URL=http://localhost:3000
