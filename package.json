{
  "name": "hairmate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=22.23.2 <23", "pnpm": "10.33.4" },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && pnpm --filter @hairmate/mobile typecheck",
    "test:unit": "vitest run --project unit && pnpm --filter @hairmate/mobile test:unit",
    "test:integration": "vitest run --project integration",
    "test:contracts": "vitest run --project contracts",
    "test:architecture": "vitest run --project architecture && node scripts/check-architecture.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @hairmate/mobile build && node scripts/check-mobile-build.mjs",
    "dev:api": "node --conditions=development --import tsx apps/api/src/main.ts",
    "dev:worker": "node --conditions=development --import tsx apps/worker/src/main.ts",
    "dev:mobile": "pnpm --filter @hairmate/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "pg": "8.23.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.1",
    "vitest": "4.1.10"
  }
}
